# 多教师账号，格式：账号:密码[:显示名]，逗号分隔
TEACHERS=018:018018:018老师,test:111222:测试老师
# 未配置 TEACHERS 时，使用下面的单账号配置
# TEACHER_ACCOUNT=018
# TEACHER_PASSWORD=018018
# TEACHER_NAME=018老师
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash-vision-exp
PORT=8080
DATABASE_URL=postgresql://username:password@your-neon-host/neondb?sslmode=require
POSTGRES_URL=postgresql://username:password@your-neon-host/neondb?sslmode=require
DATABASE_SSL=true
